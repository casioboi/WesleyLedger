rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ─── Admins collection ────────────────────────────────────────────────────
    match /admins/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow write: if false; // Managed via Firebase Console only
    }

    // ─── NEW: Per-user subcollection structure ────────────────────────────────
    //
    //   users/{userId}/transactions/{txId}
    //   users/{userId}/profile/default
    //   users/{userId}/settings/ledger
    //
    // Each user owns their own data tree. Admins can read all.

    match /users/{userId} {
      // The parent document itself (not used for data, just for structuring)
      allow read, write: if isOwner(userId) || isAdmin();

      match /transactions/{txId} {
        allow read:   if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && validTransaction();
        allow update: if isOwner(userId) && validTransaction();
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /profile/{doc} {
        allow read:         if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && validProfile();
        allow delete:       if isOwner(userId) || isAdmin();
      }

      match /settings/{doc} {
        allow read:         if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete:       if isOwner(userId) || isAdmin();
      }
    }

    // ─── LEGACY: single-blob collection (kept for old clients during rollout) ─
    match /user_ledger_data/{userId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
    }

    // ─── Other existing collections ───────────────────────────────────────────
    match /users_metadata/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.createdAt is string;
      allow update, delete: if false;
    }

    match /subscriptions/{userId} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if isAdmin(); // Only admins can modify subscriptions
    }

    match /activity_logs/{logId} {
      allow create:            if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ─── Default deny ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }

  // ─── Validation functions ───────────────────────────────────────────────────
  function validTransaction() {
    let d = request.resource.data;
    return d.keys().hasAll(['id', 'dateIso', 'kind', 'lineId', 'amountMinor', 'createdAt'])
      && d.id is string
      && d.dateIso is string
      && (d.kind == 'income' || d.kind == 'expenditure')
      && d.lineId is string
      && d.amountMinor is number
      && d.amountMinor >= 0
      && d.createdAt is string;
  }

  function validProfile() {
    let d = request.resource.data;
    return d.keys().hasAll(['society', 'circuit', 'diocese'])
      && d.society is string
      && d.circuit is string
      && d.diocese is string;
  }
}
